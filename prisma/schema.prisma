

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  passwordHash  String

  role          UserRole @default(BUSINESS_OWNER)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id            String @id @default(uuid())

  name          String
  slug          String @unique

  country       String

  industry      String?

  users         User[]

  wallets       Wallet[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  payrolls      Payroll[]

  reputation    ReputationScore?

  financingApps FinancingApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id              String @id @default(uuid())

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  stellarAddress  String @unique

  network          String
  assetCode        String

  balance          Decimal @db.Decimal(18,2)

  createdAt DateTime @default(now())
}

model Invoice {
  id             String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  invoiceNumber  String @unique

  customerName   String
  customerEmail  String?

  amount         Decimal @db.Decimal(18,2)

  currency       String

  status         InvoiceStatus @default(PENDING)

  dueDate        DateTime

  paymentLink    String?

  payments       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Payment {
  id            String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])

  amount         Decimal @db.Decimal(18,2)

  currency       String

  txHash         String?

  senderAddress  String?

  receiverAddress String?

  status         PaymentStatus

  settledAt      DateTime?

  createdAt      DateTime @default(now())
}

model Expense {
  id             String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  title          String

  category       ExpenseCategory

  amount         Decimal @db.Decimal(18,2)

  currency       String

  description    String?

  expenseDate    DateTime

  createdAt      DateTime @default(now())
}

model Payroll {
  id             String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeName   String

  employeeEmail  String?

  salary         Decimal @db.Decimal(18,2)

  currency       String

  payDate        DateTime

  status         PayrollStatus

  createdAt      DateTime @default(now())
}

model AIConversation {
  id             String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userPrompt     String

  response       String

  createdAt      DateTime @default(now())
}

model ReputationScore {
  id               String @id @default(uuid())

  organizationId   String @unique
  organization     Organization @relation(fields: [organizationId], references: [id])

  score            Int

  paymentHistory   Float
  revenueStability Float
  settlementRate   Float
  supplierTrust    Float

  lastCalculatedAt DateTime

  createdAt DateTime @default(now())
}

model FinancingApplication {
  id             String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  type           FinancingType

  requestedAmount Decimal @db.Decimal(18,2)

  status         FinancingStatus

  reputationScore Int

  lenderName     String?

  createdAt DateTime @default(now())
}


enum UserRole {
  ADMIN
  BUSINESS_OWNER
  ACCOUNTANT
  FINANCE_MANAGER
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayrollStatus {
  PENDING
  PAID
  FAILED
}

enum FinancingStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  DISBURSED
}

enum FinancingType {
  WORKING_CAPITAL
  INVOICE_FINANCING
  SUPPLIER_CREDIT
  REVENUE_BASED
}

enum ExpenseCategory {
  OPERATIONS
  TRANSPORT
  UTILITIES
  SOFTWARE
  PAYROLL
  TAX
  OTHER
}
